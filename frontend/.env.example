# Development uses Trakive's existing local authentication provider.
VITE_AUTH_PROVIDER=local
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Production (Vercel): set VITE_AUTH_PROVIDER=supabase and provide only the
# public browser credential. Never put the service-role key in Vite variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
