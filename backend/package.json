{
  "name": "trakive-backend",
  "version": "1.0.0",
  "description": "Backend API for Trakive - Internship Onboarding & Performance Tracking Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/database/migrate.js",
    "auth:revoke-legacy-sessions": "node src/database/revoke_legacy_production_sessions.js",
    "seed": "node src/database/seed.js",
    "seed:default-accounts": "node src/database/seed_default_accounts.js",
    "db:setup": "npm run migrate && npm run seed",
    "verify:default-accounts": "node src/database/verify_default_accounts.js"
  },
  "keywords": [
    "trakive",
    "express",
    "sql",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "otplib": "^13.5.0",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
